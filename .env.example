# Copy to ".env" in this directory (start.sh loads it automatically).
# One-time local LLM setup (install Ollama + pull model): ./setup-local-llm.sh

# ---- Local LLM (default): Ollama ----
# Backend: ollama (default), openai, or none (built-in blurbs only).
# LLM_BACKEND=ollama

# Ollama listen address (no /v1 suffix; the app adds /v1).
# OLLAMA_HOST=http://127.0.0.1:11434

# Model must be pulled locally, e.g. `ollama pull llama3.2`
# LLM_MODEL=llama3.2

# Optional: different models for portfolio “why this pick” vs chat (defaults to LLM_MODEL).
# LLM_MODEL_RATIONALES=llama3.2
# LLM_MODEL_CHAT=llama3.2

# HTTP timeouts (seconds) for OpenAI-compatible calls.
# LLM_TIMEOUT_RATIONALES_S=120
# LLM_TIMEOUT_CHAT_S=180

# Optional override for Ollama’s OpenAI shim (any non-empty string works).
# OPENAI_API_KEY=ollama

# ---- Cloud OpenAI (optional) ----
# LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o-mini
